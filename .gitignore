# Dependencies
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.js

# Testing
/frontend/coverage/

# Next.js (if present in future)
/frontend/.next/
/frontend/out/

# Production builds
/frontend/build/
/frontend/dist/

# Misc
*.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — do NOT commit (contains secrets)
/frontend/.env
/frontend/.env*.local
/backend/.env
/backend/.env*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
/frontend/next-env.d.ts

# Python / Backend
__pycache__/
*.pyc
*.pyo
.venv/
/backend/.venv/
/backend/__pycache__/
/backend/**/__pycache__/

# Database
*.db

# Test artifacts
/test_*.json
/test_*.py
/scripts/test_*.py

# Backend logs
/backend/logs/
/backend/.pytest_cache/

# Backend uploads
/backend/uploads/

# General logs
*.log
/logs/

# Uploads
/uploads/

# Backend tests run scripts
/backend/tests/run

# IDE
.vscode/settings.json
.idea/
